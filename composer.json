{
    "name": "romanfedorskij/message-bus-async-worker",
    "description": "AMPHP PostgreSQL worker runtime and control CLI for romanfedorskij/message-bus-async",
    "keywords": [
        "amphp",
        "message-bus",
        "postgresql",
        "queue",
        "worker"
    ],
    "homepage": "https://github.com/wolfcharaa/message-bus-async-worker",
    "license": "MIT",
    "type": "library",
    "bin": [
        "bin/message-bus-worker"
    ],
    "require": {
        "php": "^8.4.12",
        "amphp/amp": "^3.1",
        "amphp/postgres": "^2.2.1",
        "psr/clock": "^1.0",
        "romanfedorskij/message-bus-async": "^0.1",
        "symfony/console": "^7.4 || ^8.1"
    },
    "suggest": {
        "thesis/dic": "Required to use the optional Thesis DIC WorkerModule"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "thesis/dic": "^0.5.3"
    },
    "autoload": {
        "psr-4": {
            "Fedor\\MessageBus\\Worker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedor\\MessageBus\\Worker\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/wolfcharaa/message-bus-async-worker/issues",
        "source": "https://github.com/wolfcharaa/message-bus-async-worker"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../MessageBusAsync",
            "options": {
                "symlink": true,
                "versions": {
                    "romanfedorskij/message-bus-async": "0.1.1"
                }
            }
        }
    ],
    "scripts": {
        "analyse": "phpstan analyse --level=max src tests integration-tests",
        "test": "phpunit --do-not-cache-result",
        "test:integration": "phpunit --configuration phpunit.integration.xml.dist --do-not-cache-result"
    },
    "minimum-stability": "stable"
}
